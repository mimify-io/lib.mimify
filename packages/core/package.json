{
  "name": "@mimify/core",
  "version": "0.0.1",
  "description": "JavaScript library for creating animated widgets",
  "keywords": [
    "animation",
    "widgets",
    "javascript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kirilenko/lib.mimify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirilenko/lib.mimify.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
